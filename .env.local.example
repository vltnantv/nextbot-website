# ── Email (Resend) — the /razgovor form ──
# Required: without it the form answers with an error („Не успяхме да изпратим“).
# The sender is noreply@nextbot.me, so the nextbot.me domain must be verified in Resend.
RESEND_API_KEY=re_your-resend-key
# Where new /razgovor requests go (default: info@nextbot.me)
NOTIFICATION_EMAIL=info@nextbot.me

# ── OpenAI — the site chat (NEO demo) ──
OPENAI_API_KEY=sk-your-openai-key

# ── Web3Forms — the ARIA waiting list (/aria) ──
# Emails go to the address this key belongs to.
WEB3FORMS_ACCESS_KEY=your-web3forms-key

# ── Only on your computer, never in Vercel ──
# The check after `npm run build` (scripts/check-build-no-leads.mjs) compares the build with the leads in
# Supabase when these two are set. The site itself no longer uses Supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
